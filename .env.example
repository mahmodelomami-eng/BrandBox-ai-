# ==============================================================================
# Brand Box AI — Master Environment Variables Template
# ==============================================================================

# 1. PUBLIC VARIABLES (Browser Safe)
NEXT_PUBLIC_APP_URL=https://www.brandbox-ai.com
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. SERVER-ONLY SECRET VARIABLES (NEVER Expose to Browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 3. EZONE PAY BILLING ADAPTER (Server Only)
EZONEPAY_MERCHANT_ID=your_ezonepay_merchant_id
EZONEPAY_API_KEY=your_ezonepay_api_key
EZONEPAY_API_BASE_URL=https://provider-issued-ezonepay-api-host.example
EZONEPAY_HMAC_SECRET=your_ezonepay_hmac_secret_key
EZONEPAY_ORDER_SIGNING_SECRET=your_independent_order_signing_secret
EZONEPAY_PRODUCTION_ACTIVATED=false

# Dedicated staging-only test account. Never point this at a real user.
STAGING_TEST_USER_ID=00000000-0000-4000-8000-000000000000

# 4. STORE DIGITAL DELIVERY ENCRYPTION (Server Only)
# 32-byte key encoded as 64 hex chars or base64. Generate and store only in environment secrets.
STORE_CODE_ENCRYPTION_KEY=your_32_byte_store_code_encryption_key_here

# 5. MULTI-PROVIDER AI GATEWAY SECRETS (Server Only)
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GOOGLE_VERTEX_KEY=your_google_vertex_ai_key_or_json
BFL_FLUX_API_KEY=your_black_forest_labs_api_key
RUNWAYML_API_SECRET=your_runway_server_api_secret_here

# 6. DISTRIBUTED RATE LIMITING & OBSERVABILITY (Optional / Server Only)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# 7. META WHATSAPP BUSINESS PLATFORM (Server Only)
WHATSAPP_VERIFY_TOKEN=generate_a_long_random_verify_token
WHATSAPP_APP_SECRET=your_meta_app_secret
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_GRAPH_VERSION=v23.0

# 8. SOCIAL OAUTH & PUBLISHING (Server Only)
# Dedicated 32-byte AES key encoded as 64 hex chars or base64. Do not reuse Store keys.
BRANDBOX_SOCIAL_TOKEN_ENCRYPTION_KEY=your_dedicated_32_byte_social_token_encryption_key
BRANDBOX_SOCIAL_MOBILE_RETURN_URI=brandbox://social

# Meta: Facebook Pages + linked Instagram Professional accounts
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_OAUTH_REDIRECT_URI=https://www.brandbox-ai.com/api/v1/social/oauth/meta/callback
META_GRAPH_API_VERSION=v26.0
BRANDBOX_META_PUBLISHING_ENABLED=false

# TikTok Login Kit / Content Posting API
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_OAUTH_REDIRECT_URI=https://www.brandbox-ai.com/api/v1/social/oauth/tiktok/callback
BRANDBOX_TIKTOK_PUBLISHING_ENABLED=false

# Google / YouTube Data API
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REDIRECT_URI=https://www.brandbox-ai.com/api/v1/social/oauth/youtube/callback
BRANDBOX_YOUTUBE_PUBLISHING_ENABLED=false

# LinkedIn OIDC / Share on LinkedIn
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_OAUTH_REDIRECT_URI=https://www.brandbox-ai.com/api/v1/social/oauth/linkedin/callback
BRANDBOX_LINKEDIN_PUBLISHING_ENABLED=false
