# Brand Box AI — production environment template
NEXT_PUBLIC_APP_URL=https://www.brandbox-ai.com
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only Supabase key. Required by financial/credit RPCs and server generation routes.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# OpenRouter — server only; never prefix secrets with NEXT_PUBLIC_.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ALLOWED_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet,meta-llama/llama-3.3-70b-instruct,google/gemini-2.5-flash
OPENROUTER_TIMEOUT_MS=60000
OPENROUTER_SITE_URL=https://brandbox-ai.com
OPENROUTER_APP_NAME=Brand Box AI

# Ezone Pay — deliberately inactive until the provider supplies its official production contract.
EZONEPAY_PRODUCTION_ACTIVATED=false
# EZONEPAY_API_BASE_URL=
# EZONEPAY_API_KEY=
# EZONEPAY_HMAC_SECRET=
